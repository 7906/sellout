# 智谱 GLM API 配置（复制为 server/.env 后填写真实 Key）
# 申请地址: https://open.bigmodel.cn/
GLM_API_KEY=your_zhipu_api_key_here

# API 基地址与模型（默认免费模型 glm-4-flash，可换成 glm-4-plus / glm-4.6 等）
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# 游戏服务器端口
PORT=3001

# 公网访问口令（非本机访问需输入；本机 127.0.0.1 免口令）
GATE_PASS=sellout2026

# 监听地址：部署到云服务器时改为 0.0.0.0
HOST=127.0.0.1
